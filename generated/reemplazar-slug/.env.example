# Copy to .env.local and fill in real values. Never commit .env.local.
# Grouped per .claude/skills/barbershop-crm-builder/references/deployment-and-operations.md.

NODE_ENV=development

# --- Public website ---
NEXT_PUBLIC_APP_URL=https://REEMPLAZAR_DOMINIO_DE_REEMPLAZAR_SLUG
PUBLIC_WEBSITE_ORIGIN=

# --- CRM ---
# This template ships with an in-memory CRM (LocalCrmClient) seeded from
# client-config.json — no external CRM credentials are required to run,
# lint, typecheck, test, or build. If a networked CRM backend (e.g. a
# spreadsheet+script backend) is added later, its URL/key/secret go here —
# never in NEXT_PUBLIC_-prefixed variables, and never reachable from the
# browser. See src/lib/crm/signing.ts.
CRM_PROVIDER=local
CRM_BACKEND_URL=
CRM_API_KEY=
CRM_SIGNING_SECRET=

# --- Admin auth ---
AUTH_SECRET=
ADMIN_EMAIL=
# Generate with your project's password-hashing script.
ADMIN_PASSWORD_HASH=

# --- Optional: WhatsApp (features.whatsapp) ---
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Optional: AI assistant (features.aiAssistant) ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Optional: reminders / notifications (features.reminders) ---
CRON_SECRET=

# --- Optional: email notifications (features.emailNotifications) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Optional: Google Calendar sync (features.googleCalendar) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
