    });
    result.inserted++;
  }
  return result;
}

function actionImportSeed_(payload) {
  var summary = {
    settings: importSettingsRows_(payload.settings),
    services: importServiceRows_(payload.services),
    staff: importStaffRows_(payload.staff),
    staffServices: importStaffServiceRows_(payload.staffServices),
    workingHours: importWorkingHoursRows_(payload.workingHours),
    breaks: importBreakRows_(payload.breaks),
  };
  writeAuditEntry_("importSeed", "Crm", "bulk", "admin", summary);
  return summary;
}
