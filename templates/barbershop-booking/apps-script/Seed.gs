  if (!rows) return result;
  var existing = sheetToObjects_(SHEET_NAMES.BREAKS);
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    var staffId = requireString_(row, "staffId");
    var dayOfWeek = requireString_(row, "dayOfWeek");
    var startTime = requireLocalTime_(row, "startTime");
    var endTime = requireLocalTime_(row, "endTime");
    var already = findRowsWhere_(
      SHEET_NAMES.BREAKS,
      function (r) {
        return r.staffId === staffId && r.dayOfWeek === dayOfWeek && r.startTime === startTime && r.endTime === endTime;
      },
      existing,
