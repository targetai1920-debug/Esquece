# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets — .env.example is the exception)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
*.local

# factory output — a full generated client project is never committed to
# this repo (see docs/OPERATOR_GUIDE.md §12: one independent repo per
# client). Only the small placeholder fixture clients/reemplazar-slug.yaml
# stays versioned.
/generated/*
!/generated/README.md
/crm-init/
